# Nom de domaine du site — modifiable sans toucher au code (config/site.config.ts le lit)
NEXT_PUBLIC_SITE_DOMAIN=renversement.africa

# Date de révélation (Jour J), format ISO 8601 en UTC.
# Africa/Abidjan = UTC+0 toute l'année, donc l'heure ici EST l'heure d'Abidjan.
# Si cette variable n'est PAS définie, le compte à rebours démarre automatiquement
# à "maintenant + 120h" au premier build/déploiement (voir computeDefaultLaunchDate).
# Exemple si le lancement est prévu le 15 août 2026 à 9h locales Abidjan :
# NEXT_PUBLIC_LAUNCH_DATE_ISO=2026-08-15T09:00:00Z
